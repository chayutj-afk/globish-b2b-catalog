{
  "rewrites": [
    {
      "source": "/",
      "destination": "/home.html"
    },
    {
      "source": "/catalog",
      "destination": "/api/catalog"
    },
    {
      "source": "/request",
      "destination": "/request.html"
    },
    {
      "source": "/users",
      "destination": "/users.html"
    },
    {
      "source": "/import-wh",
      "destination": "/import-wh.html"
    },
    {
      "source": "/ar",
      "destination": "/ar.html"
    },
    {
      "source": "/api/peak-webhook/:type",
      "destination": "/api/users?view=peak-hook&type=:type"
    }
  ],
  "functions": {
    "api/invoice-requests.js": {
      "maxDuration": 30
    },
    "api/contacts.js": {
      "maxDuration": 30
    },
    "api/catalog.js": {
      "includeFiles": "2026B2BStandardCatalog.html"
    },
    "api/wh-packages.js": {
      "maxDuration": 30
    },
    "api/users.js": {
      "maxDuration": 30
    },
    "api/requests.js": {
      "maxDuration": 30
    }
  },
  "crons": [
    {
      "path": "/api/users?view=health-cron",
      "schedule": "17 1 * * *"
    }
  ]
}
