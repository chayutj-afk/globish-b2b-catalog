# ---- Sign-in (Google, @globish.co.th only) ----
GOOGLE_CLIENT_ID=            # same OAuth client as License Desk is fine
GOOGLE_CLIENT_SECRET=        # add redirect URI https://<domain>/api/auth/callback to the client
AUTH_SECRET=                 # long random string (openssl rand -hex 32); signs session cookies
ALLOWED_EMAIL_DOMAIN=globish.co.th
OWNER_EMAILS=chayut.j@globish.co.th
OPS_EMAILS=                  # comma-separated: who can edit and publish packages
APP_URL=                     # optional, e.g. https://globish-b2b-catalog.vercel.app

# ---- Publish packages.json (Manage tab) ----
GITHUB_TOKEN=
GITHUB_OWNER=chayutj-afk
GITHUB_REPO=globish-b2b-catalog
GITHUB_BRANCH=main

# ---- Revenue Hub (Google Sheet, service account) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=   # same service account as License Desk is fine
GOOGLE_PRIVATE_KEY=             # -----BEGIN PRIVATE KEY----- block, \n allowed
HUB_SHEET_ID=1t_nmZoTRD720ZSzg0CPUy_uh1V0Y4RPB5mIsIDhMJYc
DOCS_FOLDER_ID=                 # folder in a Shared Drive for INV evidence uploads (optional)
# HUB_MODE=mock                 # local runs only: write to a JSON file instead of the sheet

# ---- PEAK (leave PEAK_MODE=off until UAT is tested) ----
PEAK_MODE=off                # off | uat | prod
PEAK_CONNECT_ID=
PEAK_PASSWORD=
PEAK_USER_TOKEN=
GCHAT_WEBHOOK_URL=
